{
  "name": "obsigent",
  "version": "0.1.0",
  "description": "A local AI chat sidebar that can help with your Obsidian notes.",
  "type": "module",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vault": "node scripts/copy-plugin-assets.mjs && node esbuild.config.mjs --vault",
    "prepare:gemma4": "node scripts/prepare-gemma4.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "biome check . && tsc -noEmit -skipLibCheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "release:validate": "node scripts/validate-release.mjs",
    "package": "node scripts/package-plugin.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "local-ai",
    "ollama",
    "vault-agent",
    "ai-notes"
  ],
  "author": "Ken Kai",
  "homepage": "https://www.youtube.com/@kenkaidoesai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenKaiii/obsigent.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/node": "^25.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "@kenkaiiii/gg-agent": "file:vendor/kenkaiiii-gg-agent-4.3.177.tgz",
    "@kenkaiiii/gg-ai": "file:vendor/kenkaiiii-gg-ai-4.3.177.tgz",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@kenkaiiii/gg-ai": "file:vendor/kenkaiiii-gg-ai-4.3.177.tgz"
    }
  }
}
